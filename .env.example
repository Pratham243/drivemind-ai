# Copy this file to .env and fill in values as needed.
# The application runs fully without any of these set (MockLLMProvider,
# in-memory vehicle state, TF-IDF/rule-based NLU by default).

# --- LLM (optional) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- NLU model selection ---
# One of: baseline (TF-IDF+LogReg), transformer (DistilBERT), llm
NLU_MODEL=baseline

# --- Logging ---
LOG_LEVEL=INFO

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Streamlit -> API connection ---
API_BASE_URL=http://localhost:8000
